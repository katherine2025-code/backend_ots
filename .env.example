# Copia este archivo como .env y completa los valores. NUNCA subas el .env a git.

# --- Servidor ---
# Puerto HTTP de la API (el front en desarrollo apunta a http://localhost:3000/api)
PORT=3000
# development | production (solo cambia mensajes de log y el correo de prueba por consola)
NODE_ENV=development

# --- Base de datos (MariaDB / MySQL) ---
# Host de la BD. En local con Docker: 127.0.0.1. Si la API corre en Docker: nombre del servicio de la BD
DB_HOST=127.0.0.1
# Puerto de la BD (3306 por defecto)
DB_PORT=3306
# Usuario con permisos sobre la base DB_NAME (GRANT ALL ON ots.*)
DB_USER=ots_user
# Contraseña de ese usuario
DB_PASSWORD=cambia_esta_contrasena
# Nombre de la base de datos
DB_NAME=ots

# --- Autenticación (JWT) ---
# OBLIGATORIO: secreto para firmar los tokens. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=pega_aqui_un_secreto_largo_y_aleatorio
# Duración del token (formato de jsonwebtoken: 24h, 7d, ...)
JWT_EXPIRES_IN=24h

# --- Frontend ---
# Origen(es) del front permitidos por CORS, separados por coma. El primero se usa para armar el
# enlace del correo de "olvidé mi contraseña". Los localhost:8100/8101 ya están permitidos siempre.
FRONTEND_URL=http://localhost:8100

# --- Microservicio Python (ETL + Machine Learning) ---
# URL base del microservicio FastAPI
ML_SERVICE_URL=http://localhost:5000
# OBLIGATORIO: token compartido con el microservicio (se envía en el header X-Service-Token).
# Debe ser IGUAL al SERVICE_TOKEN del microservicio. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SERVICE_TOKEN=pega_aqui_el_mismo_token_que_en_el_microservicio

# --- Correo (SMTP) - opcional ---
# Si se deja vacío, el correo no se envía: en desarrollo se imprime por consola.
# Servidor SMTP, ej. smtp.gmail.com
SMTP_HOST=
# 465 (SSL) o 587 (STARTTLS)
SMTP_PORT=587
# 'true' para el puerto 465, 'false' para 587
SMTP_SECURE=false
# Cuenta remitente
SMTP_USER=
# Contraseña o App Password (Gmail exige App Password)
SMTP_PASS=
# Remitente visible, ej. "OTS UPSE <no-reply@ejemplo.com>"
SMTP_FROM=
